---
import { SITE, LANGS, HTML_LANG, type Lang } from '../consts';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 文章页传 'article'，其余留空 */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { lang, title, description, type = 'website', publishedTime, modifiedTime } = Astro.props;

const desc = description ?? ui[lang]['site.description'];
const canonical = new URL(Astro.url.pathname, Astro.site);

// 把路径首段的语言码换掉，得到其他语言的同位页面
const segments = Astro.url.pathname.split('/').filter(Boolean);
const rest = segments.slice(1).join('/');
const altHref = (target: Lang) => new URL(`/${target}/${rest}${rest ? '/' : ''}`, Astro.site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical.href} />

{LANGS.map((code) => <link rel="alternate" hreflang={HTML_LANG[code]} href={altHref(code)} />)}
<link rel="alternate" hreflang="x-default" href={altHref('zh')} />

<link rel="alternate" type="application/rss+xml" title={`${SITE.wordmark} — ${ui[lang]['site.tagline']}`} href={new URL(`/${lang}/rss.xml`, Astro.site).href} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={SITE.wordmark} />
<meta property="og:locale" content={HTML_LANG[lang]} />
<meta property="og:image" content={new URL('/avatar.jpg', Astro.site).href} />
<meta property="og:image:width" content="512" />
<meta property="og:image:height" content="512" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#fcfbf8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#14140f" media="(prefers-color-scheme: dark)" />

<script is:inline>
  // 首屏前定好明暗，避免闪白
  (function () {
    try {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') {
        document.documentElement.dataset.theme = saved;
      }
    } catch (e) {}
  })();
</script>
