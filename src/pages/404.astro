---
import Base from '../layouts/Base.astro';
import { DEFAULT_LANG } from '../consts';
import { useTranslations } from '../i18n/ui';

const lang = DEFAULT_LANG;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('notfound.title')} description={t('notfound.body')}>
  <div class="notfound">
    <h1>404</h1>
    <p>{t('notfound.body')}</p>
    <p>
      <a href="/zh/">中文</a> · <a href="/ja/">日本語</a> · <a href="/en/">English</a>
    </p>
  </div>
</Base>
