---
// 根路径不承载内容，只按浏览器语言把人送到 /zh/ /ja/ /en/。
import { DEFAULT_LANG, SITE } from '../consts';
---

<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.wordmark}</title>
    <link rel="canonical" href={`${SITE.url}/${DEFAULT_LANG}/`} />
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LANG}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var supported = ['zh', 'ja', 'en'];
        var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'zh'];
        var target = 'zh';
        for (var i = 0; i < list.length; i++) {
          var code = String(list[i]).toLowerCase().split('-')[0];
          if (supported.indexOf(code) !== -1) {
            target = code;
            break;
          }
        }
        location.replace('/' + target + '/');
      })();
    </script>
  </head>
  <body>
    <p style="font-family: sans-serif; padding: 2rem;">
      <a href={`/${DEFAULT_LANG}/`}>{SITE.wordmark} →</a>
    </p>
  </body>
</html>
