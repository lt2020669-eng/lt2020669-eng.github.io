---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { LANGS, SITE, type Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { getAllPosts } from '../../lib/posts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// 首页就是自我介绍页：正文来自 src/content/about/{zh,ja,en}.md
const entry = await getEntry('about', lang);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const title = entry?.data.title ?? t('nav.about');

const posts = (await getAllPosts(lang)).slice(0, 8);
---

<Base
  lang={lang}
  title={SITE.wordmark}
  description={entry?.data.summary ?? t('site.description')}
  wide={false}
>
  <article class="intro">
    <header class="article__head">
      <img
        class="avatar"
        src={SITE.avatar}
        width="112"
        height="112"
        alt={SITE.author}
        fetchpriority="high"
        decoding="async"
      />
      <h1>{title}</h1>
    </header>

    <div class="prose">
      {Content ? <Content /> : <p class="empty">{t('list.empty')}</p>}
    </div>
  </article>

  <section class="home-latest">
    <p class="section-label">
      <span>{t('home.latest')}</span>
      <span class="rule" aria-hidden="true"></span>
      <a href={`/${lang}/archive/`}>{t('home.more')}</a>
    </p>
    <EntryList posts={posts} lang={lang} showKind />
  </section>
</Base>
