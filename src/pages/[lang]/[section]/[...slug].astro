---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { LANGS, LANG_LABEL, SECTIONS, type Lang } from '../../../consts';
import { useTranslations } from '../../../i18n/ui';
import {
  excerpt,
  formatDate,
  getNeighbours,
  getPosts,
  getTranslations,
  isoDate,
  type Post,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const section of SECTIONS) {
      for (const post of await getPosts(section, lang)) {
        paths.push({ params: { lang, section, slug: post.slug }, props: { post } });
      }
    }
  }
  return paths;
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = post.lang;
const t = useTranslations(lang);

const { Content } = await render(post.entry);
const translations = await getTranslations(post);
const { prev, next } = await getNeighbours(post);

const sectionLabel = post.section === 'blog' ? t('blog.title') : t('diary.title');
const description = post.summary || excerpt(post.entry.body, 110);
---

<Base
  lang={lang}
  title={post.title}
  description={description}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.updated}
  wide={false}
>
  <article>
    <header class="article__head">
      <h1>{post.title}</h1>
      <p class="article__meta">
        <time datetime={isoDate(post.date)}>{formatDate(post.date, lang)}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{t('post.readingTime', { n: post.minutes })}</span>
        <span class="dot" aria-hidden="true"></span>
        <a href={`/${lang}/${post.section}/`}>{sectionLabel}</a>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="article__foot">
      {
        post.tags.length > 0 && (
          <p class="tag-row">
            {post.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>
        )
      }

      {
        translations.length > 0 && (
          <p>
            {t('post.translations')}：
            {translations.map((other, index) => (
              <>
                {index > 0 && '、'}
                <a href={other.href}>{LANG_LABEL[other.lang]}</a>
              </>
            ))}
          </p>
        )
      }

      {
        (prev || next) && (
          <nav class="pager" aria-label={sectionLabel}>
            {prev && (
              <a class="pager__item" href={prev.href}>
                <span class="pager__label">← {t('post.prev')}</span>
                <span class="pager__title">{prev.title}</span>
              </a>
            )}
            {next && (
              <a class="pager__item pager__item--next" href={next.href}>
                <span class="pager__label">{t('post.next')} →</span>
                <span class="pager__title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>
</Base>
