---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { LANGS, SITE, type Lang } from '../../consts';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const entry = await getEntry('about', lang);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const title = entry?.data.title ?? t('about.title');
---

<Base lang={lang} title={title} description={entry?.data.summary ?? t('site.description')} wide={false}>
  <article>
    <header class="article__head">
      <img
        class="avatar"
        src={SITE.avatar}
        width="112"
        height="112"
        alt={SITE.author}
        fetchpriority="high"
        decoding="async"
      />
      <h1>{title}</h1>
    </header>
    <div class="prose">
      {Content ? <Content /> : <p class="empty">{t('list.empty')}</p>}
    </div>
  </article>
</Base>
